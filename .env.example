# Postgres (Neon free tier). Must have the pg_trgm extension available.
# DATABASE_URL: pooled connection, used by the app at runtime.
# DATABASE_URL_UNPOOLED: direct connection, used only for migrations
# (npm run db:migrate) — falls back to DATABASE_URL if not set.
DATABASE_URL=postgres://user:password@host-pooler:5432/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host:5432/dbname?sslmode=require

# LLM provider: "openrouter" (default, free demo) or "claude" (future switch)
LLM_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Pick a current free model from https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=openrouter/auto

# Anthropic (only needed when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
